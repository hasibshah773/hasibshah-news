{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "840px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "brand-primary",
					"color": "#0A192F",
					"name": "Editorial Navy"
				},
				{
					"slug": "brand-accent",
					"color": "#C90000",
					"name": "Breaking Crimson"
				},
				{
					"slug": "cat-bangladesh",
					"color": "#006A4E",
					"name": "National Green"
				},
				{
					"slug": "cat-business",
					"color": "#0F52BA",
					"name": "Business Blue"
				},
				{
					"slug": "cat-sports",
					"color": "#E65100",
					"name": "Sports Amber"
				},
				{
					"slug": "bg-surface",
					"color": "#F8F9FA",
					"name": "Paper Surface"
				},
				{
					"slug": "text-main",
					"color": "#1A1A1A",
					"name": "Ink Black"
				},
				{
					"slug": "text-muted",
					"color": "#555555",
					"name": "Muted Charcoal"
				},
				{
					"slug": "border-subtle",
					"color": "#E9ECEF",
					"name": "Border Subtle"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.35rem",
					"fluid": {
						"min": "1.15rem",
						"max": "1.5rem"
					},
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.35rem",
						"max": "2.25rem"
					},
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.75rem"
					},
					"name": "Lead Headline"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text-main)"
		},
		"typography": {
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--brand-primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--brand-accent)"
					}
				}
			},
			"heading": {
				"typography": {
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--brand-primary)"
				}
			}
		}
	}
}
